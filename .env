# Kafka
KAFKA_BROKER=kafka:9092
RAW_TOPIC=raw-food-orders
PROCESSED_TOPIC=processed-food-orders

# Pinot
PINOT_CONTROLLER=http://pinot-controller:9000
PINOT_BROKER=http://pinot-broker:8099
PINOT_CLUSTER_NAME=FoodOrderCluster

# Producer Settings
ORDER_INTERVAL_MIN=0.5
ORDER_INTERVAL_MAX=2.0
